(version v0.17.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   async_kernel
   async_rpc_kernel
   core
   ppx_jane
   dune
   js_of_ocaml
   js_of_ocaml-ppx
   uri
   uri-sexp)))

(source
 (fetch
  (url
   https://github.com/janestreet/async_js/archive/refs/tags/v0.17.0.tar.gz)
  (checksum
   sha256=6c8898b69bd5fc0c36d0bbcf5a1a5a2cb0b5deb88504cdaeb532c50b50ac1703)))
