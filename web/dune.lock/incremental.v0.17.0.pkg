(version v0.17.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   core
   core_kernel
   janestreet_lru_cache
   ppx_jane
   ppx_optcomp
   uopt
   dune)))

