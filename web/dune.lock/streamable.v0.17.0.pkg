(version v0.17.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   async_kernel
   async_rpc_kernel
   base
   core
   core_kernel
   ppx_jane
   dune
   ppxlib)))

(source
 (fetch
  (url
   https://github.com/janestreet/streamable/archive/refs/tags/v0.17.0.tar.gz)
  (checksum
   sha256=4c59a31870f77b89727e2f986727a2ed865e8336df4b409b716dd6508d9b8a63)))
