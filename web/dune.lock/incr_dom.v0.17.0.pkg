(version v0.17.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   async_js
   async_kernel
   core
   core_kernel
   incr_map
   incr_select
   incremental
   ppx_jane
   virtual_dom
   dune
   js_of_ocaml
   js_of_ocaml-ppx)))

(source
 (fetch
