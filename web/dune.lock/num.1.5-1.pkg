(version 1.5-1)

(build
 (all_platforms
  ((action
    (progn
     (patch num-in-findlib-dir.patch)
     (run
      %{make}
      PROFILE=release
      (when
       (catch_undefined_var
        (and_absorb_undefined_var
         (not %{pkg:ocaml:preinstalled})
         (< %{pkg:ocaml:version} 5.0.0~~))
        false)
       opam-legacy)
      (when
       (catch_undefined_var
        (or_absorb_undefined_var
         %{pkg:ocaml:preinstalled}
         (>= %{pkg:ocaml:version} 5.0.0~~))
        false)
       opam-modern)))))))

(depends
 (all_platforms (ocaml)))

(source
 (fetch
  (url https://github.com/ocaml/num/archive/v1.5.tar.gz)
  (checksum
   sha512=110dd01140c1c96f5f067aa824bb63f74a26411dcaa65aaf04cb6c44b116ca02aaab9505f431c66964388ce4a31d86da5928b4c0e5557800e834de80bed46495)))

(extra_sources
 (num-in-findlib-dir.patch
  (fetch
   (url
    https://github.com/ocaml/num/commit/f6e31b1653f32c7c425b69c2b123ab2f924a4d61.patch?full_index=1)
   (checksum
    sha256=f93880031ed823249f4aac860e0d9e5cdc2878550db13914db25b1585803cf05))))
