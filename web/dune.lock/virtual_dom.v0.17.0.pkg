   base
   core
   core_kernel
   js_of_ocaml_patches
   ppx_jane
   stdio
   base64
   dune
   gen_js_api
   js_of_ocaml
   js_of_ocaml-ppx
   lambdasoup
   tyxml
   uri)))

(source
 (fetch
