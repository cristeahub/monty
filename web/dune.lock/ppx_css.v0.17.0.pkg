(version v0.17.0)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   async
   async_unix
   core
   core_kernel
   core_unix
   ppx_here
   ppx_jane
   ppx_let
   ppx_sexp_conv
   ppx_string
   stdio
   virtual_dom
   dune
   js_of_ocaml
   js_of_ocaml-ppx
   menhirLib
   ppxlib
   sedlex)))

(source
 (fetch
  (url
   https://github.com/janestreet/ppx_css/archive/refs/tags/v0.17.0.tar.gz)
  (checksum
   sha256=e60e31aadd820b131f7f05827f369164564400bd4fd51c199d066abf7e68753f)))
