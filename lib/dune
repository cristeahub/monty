(library
 (name monty)
 (foreign_stubs (language c) (names worker_lock_stubs))
 (libraries cmdliner fmt fpath unix yojson base64 eqaf uri lwt.unix cohttp-lwt-unix websocket digestif))

(rule
 (target embedded_manual.ml)
 (deps ../docs/monty-workflows.md)
 (action
  (with-stdout-to %{target}
   (progn
    (echo "let text = {monty_manual|")
    (cat %{dep:../docs/monty-workflows.md})
    (echo "|monty_manual}")))))

