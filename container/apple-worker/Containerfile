FROM docker.io/node:24-bookworm@sha256:199c73562361671327587c4e1dd1d5b8326e5a0f15b7bd99b90d5c4ef9907e9e AS node-toolchain

FROM docker.io/ocaml/opam:debian-13-ocaml-5.4@sha256:67c91b831ef7ba924b4968cf029246c540822d3b43e9c4995eaa7ba5956d6ccc

USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates coreutils curl git gh jq ripgrep \
      perl libdigest-sha-perl pkg-config unzip zip xz-utils gnupg shellcheck \
      python3 python3-dev python3-venv libssl-dev libffi-dev libpq-dev \
      libgeos-dev libgdal-dev libproj-dev libcrypt-dev gdal-bin gettext \
      postgresql postgresql-contrib postgis postgresql-17-postgis-3 redis-server \
      poppler-utils libxrender1 chromium fonts-liberation openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=node-toolchain /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global npm@11.12.1

RUN curl -fLsS https://github.com/astral-sh/uv/releases/download/0.11.3/uv-aarch64-unknown-linux-gnu.tar.gz -o /tmp/uv.tar.gz \
    && echo '711382e3158433f06b11d99afb440f4416359fc3c84558886d8ed8826a921bff  /tmp/uv.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/uv.tar.gz -C /tmp \
    && install -m 0755 /tmp/uv-aarch64-unknown-linux-gnu/uv /tmp/uv-aarch64-unknown-linux-gnu/uvx /usr/local/bin/ \
    && UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install 3.14 --default \
    && rm -rf /tmp/uv.tar.gz /tmp/uv-aarch64-unknown-linux-gnu

RUN curl -fLsS https://static.rust-lang.org/rustup/archive/1.28.2/aarch64-unknown-linux-gnu/rustup-init -o /tmp/rustup-init \
    && echo 'e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c  /tmp/rustup-init' | sha256sum -c - \
    && chmod 0755 /tmp/rustup-init \
    && CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain 1.85.1 --component rustfmt --component clippy \
    && rm /tmp/rustup-init

RUN curl -fLsS https://releases.hashicorp.com/terraform/1.13.5/terraform_1.13.5_linux_arm64.zip -o /tmp/terraform.zip \
    && echo 'fc1ddcb403fb57e25bdbdceb1ef2b1a102650c01b4d65dd3410082d2ef8b4417  /tmp/terraform.zip' | sha256sum -c - \
    && unzip /tmp/terraform.zip terraform -d /usr/local/bin \
    && rm /tmp/terraform.zip

USER opam
RUN opam install --yes --jobs=4 dune.3.24.2
RUN git clone https://github.com/cristeahub/wt.git /tmp/wt \
    && git -C /tmp/wt checkout --detach bac1e42a630627a5200151163ffa5565e18f1f25 \
    && cd /tmp/wt \
    && opam exec -- dune build -j 4 bin/main.exe

USER root
# Both Codex tarballs have the same npm package name; merge only the ARM64 vendor payload.
RUN install -m 0755 /tmp/wt/_build/default/bin/main.exe /usr/local/bin/wt \
    && mkdir /tmp/codex \
    && npm pack --pack-destination /tmp/codex @openai/codex@0.153.0 \
    && npm pack --pack-destination /tmp/codex @openai/codex@0.153.0-linux-arm64 \
    && node -e 'const c=require("crypto"),f=require("fs");if(c.createHash("sha512").update(f.readFileSync(process.argv[1])).digest("base64")!==process.argv[2])process.exit(1)' \
      /tmp/codex/openai-codex-0.153.0.tgz \
      k55kUZaclNi5ceUStSVuyW834ruA6AEdzTK7Xi3M1mOyXokUmq1sJLXm1RJ3XD2S7bRPeF1EXNsYB5Qxwus0mw== \
    && node -e 'const c=require("crypto"),f=require("fs");if(c.createHash("sha512").update(f.readFileSync(process.argv[1])).digest("base64")!==process.argv[2])process.exit(1)' \
      /tmp/codex/openai-codex-0.153.0-linux-arm64.tgz \
      N2zLgmuslhMoC2RFC2aDkcCWk3iapZmBlSiESpjXFF+UMNxIpNxWJ5qQtQrCp5Md7kYbF4/EFy8RqJ8tL8UTeA== \
    && npm install --global --offline --omit=optional \
      /tmp/codex/openai-codex-0.153.0.tgz \
    && tar -xzf /tmp/codex/openai-codex-0.153.0-linux-arm64.tgz \
      --strip-components=1 -C /usr/local/lib/node_modules/@openai/codex package/vendor \
    && rm -rf /tmp/codex \
    && npm cache clean --force \
    && groupadd --gid 10001 monty \
    && useradd --create-home --uid 10001 --gid 10001 --shell /bin/bash monty

COPY --chmod=0755 monty-inspect /usr/local/bin/monty-inspect
RUN apt-get update && apt-get install -y --no-install-recommends zsh \
    # Codex's bundled Bubblewrap supports its proc-mount fallback in Apple VMs.
    && apt-get remove -y bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && chmod a+rx /home/opam /home/opam/.opam \
    && chmod -R a+rX /home/opam/.opam/5.4 /opt/python /opt/rustup /opt/cargo \
    && printf '%s\n' 'export PATH="/home/opam/.opam/5.4/bin:/opt/cargo/bin:/usr/lib/postgresql/17/bin:$PATH"' \
      > /etc/profile.d/monty-toolchain.sh

RUN curl -fLsS https://github.com/foundry-rs/foundry/releases/download/v1.7.1/foundry_v1.7.1_linux_arm64.tar.gz -o /tmp/foundry.tar.gz \
    && echo 'c8fe8fa09ae3aba2c81b510c6f9da3a9d468029b9580e690b245b3f0aea687ae  /tmp/foundry.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/foundry.tar.gz -C /usr/local/bin forge cast anvil chisel \
    && curl -fLsS https://github.com/cakevm/huff-neo/releases/download/v1.5.17/hnc-v1.5.17-aarch64-unknown-linux-gnu.tar.gz -o /tmp/hnc.tar.gz \
    && echo '00e4076d6d48ad03ee945a914802f7126756c78ae03fb083d3f88b6ddf68babd  /tmp/hnc.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/hnc.tar.gz -C /usr/local/bin hnc \
    && rm /tmp/foundry.tar.gz /tmp/hnc.tar.gz

# The auxiliary MEV tools pin a newer Node/npm pair than the web projects.
RUN curl -fLsS https://nodejs.org/dist/v24.19.0/node-v24.19.0-linux-arm64.tar.xz -o /tmp/node.tar.xz \
    && echo '01443c1e1a29e531ccad5a46fefa6df490d2189c49f7955904aecdbb0fe86fdc  /tmp/node.tar.xz' | sha256sum -c - \
    && mkdir /opt/node-24.19.0 \
    && tar -xJf /tmp/node.tar.xz --strip-components=1 -C /opt/node-24.19.0 \
    && PATH="/opt/node-24.19.0/bin:$PATH" npm install --global --prefix /opt/node-24.19.0 npm@11.17.0 \
    && rm /tmp/node.tar.xz

ENV PATH=/home/opam/.opam/5.4/bin:/opt/cargo/bin:/usr/lib/postgresql/17/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV RUSTUP_HOME=/opt/rustup
ENV UV_PYTHON_INSTALL_DIR=/opt/python
ENV HOME=/monty/home
ENV CODEX_HOME=/monty/home/.codex
LABEL com.monty.image=apple-worker-v1
RUN mkdir /tmp/pi \
    && npm pack --pack-destination /tmp/pi @earendil-works/pi-coding-agent@1.0.2 \
    && node -e 'const c=require("crypto"),f=require("fs");if(c.createHash("sha512").update(f.readFileSync(process.argv[1])).digest("base64")!==process.argv[2])process.exit(1)' \
      /tmp/pi/earendil-works-pi-coding-agent-1.0.2.tgz \
      3ZdIghMSELMGV3sKi5iASOb1Jwb696fLjmNu0aezaqDxTLLWWoRpqBYkGxJ1CgAMCbtfqXWEF0lcRrlVXmiEGQ== \
    && npm install --global --ignore-scripts /tmp/pi/earendil-works-pi-coding-agent-1.0.2.tgz \
    && rm -rf /tmp/pi \
    && npm cache clean --force
LABEL com.monty.pi=1.0.2
USER monty
RUN codex --version && pi --version && dune --version && ocamlc -version && wt --help \
    && git --version && cc --version && make --version && bash --version \
    && curl --version && jq --version && rg --version && node --version && npm --version \
    && python3.14 --version && uv --version && rustc --version && cargo --version \
    && terraform version && psql --version && gdalinfo --version && redis-server --version \
    && chromium --version && java --version && gh --version && shasum --version && zsh --version \
    && bash -lc 'dune --version && ocamlc -version && cargo --version && rustc --version' \
    && forge --version && cast --version && anvil --version && hnc --version \
    && /opt/node-24.19.0/bin/node --version \
    && PATH="/opt/node-24.19.0/bin:$PATH" npm --version
WORKDIR /home/monty
ENTRYPOINT []
CMD ["sleep", "infinity"]
